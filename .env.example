NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public recipient address for the marketing contact form (mailto; no server-side mail delivery).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional client-side product analytics. Collection starts only after consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Sentry project DSN. Public DSNs are designed to be exposed.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only Sentry DSN; falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=

# Server-only: never use the SUPABASE_SECRET_KEY in browser code.
SUPABASE_SECRET_KEY=

# Embeddings are disabled by default.
# Set to "ollama" for local/Cloud Ollama or "openai" for OpenAI embeddings.
AI_EMBEDDING_PROVIDER=disabled

# Set to "ollama" to generate bookmark titles, descriptions, and tags.
AI_BOOKMARK_ENRICHMENT_PROVIDER=disabled

# Set to "ollama" to answer library questions with the configured chat model.
# If unset, Ask Your Library uses AI_BOOKMARK_ENRICHMENT_PROVIDER.
AI_ANSWER_PROVIDER=

# Server-only Tavily key for global web search in Ask Your Library.
TAVILY_API_KEY=

# Use the local URL for local Ollama, or https://ollama.com for Ollama Cloud.
# Keep OLLAMA_API_KEY server-only; it is sent only to the official cloud host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_TEXT_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Set these to the selected Ollama Cloud model's current prices, in USD per 1M tokens.
OLLAMA_INPUT_USD_PER_MILLION_TOKENS=
OLLAMA_OUTPUT_USD_PER_MILLION_TOKENS=

# Basic Search normally costs 1 credit; the actual per-response usage is recorded.
# Set this to your effective USD per credit from your Tavily billing plan.
TAVILY_COST_PER_CREDIT_USD=

# Comma-separated Supabase user UUIDs allowed to view global provider cost summaries.
BILLING_ADMIN_USER_IDS=

# Server-only credential for the configured OpenAI provider.
OPENAI_API_KEY=

# Enable this only for local development with the Inngest Dev Server.
INNGEST_DEV=1

# Server-only Inngest keys. Not required for the local Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Server-only Stripe webhook configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
STRIPE_PRO_PRICE_ID=
# Legacy Price IDs are only needed to keep existing Power/Team subscriptions in sync.
# Do not configure them for new plan purchases.
STRIPE_POWER_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
