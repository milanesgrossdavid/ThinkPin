NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never use the SUPABASE_SECRET_KEY in browser code.
SUPABASE_SECRET_KEY=

# Embeddings are disabled by default to avoid paid API usage.
# Set to "ollama" for free local embeddings or "openai" for paid embeddings.
AI_EMBEDDING_PROVIDER=disabled

# Set to "ollama" to generate local bookmark titles, descriptions, and tags.
AI_BOOKMARK_ENRICHMENT_PROVIDER=disabled

# Set to "ollama" to answer library questions with the local chat model.
# If unset, Ask Your Library uses AI_BOOKMARK_ENRICHMENT_PROVIDER.
AI_ANSWER_PROVIDER=

# Server-only Tavily key for global web search in Ask Your Library.
TAVILY_API_KEY=

# Optional local Ollama URL; Ollama must listen only on this device.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=

# Server-only credential for the configured OpenAI provider.
OPENAI_API_KEY=

# Enable this only for local development with the Inngest Dev Server.
INNGEST_DEV=1

# Server-only Inngest keys. Not required for the local Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Server-only Stripe webhook configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
STRIPE_PRO_PRICE_ID=
# Optional until these plans are launched.
STRIPE_POWER_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
