NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never use the SUPABASE_SECRET_KEY in browser code.
SUPABASE_SECRET_KEY=

# Enable this only for local development with the Inngest Dev Server.
INNGEST_DEV=1

# Server-only Inngest keys. Not required for the local Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Server-only Stripe webhook configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional until these plans are launched.
STRIPE_POWER_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
